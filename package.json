{
  "name": "patapatajs",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm run check:js && npm run check:html-scripts && npm run typecheck",
    "check:js": "node --check patapata.js && node --check patapata.min.js",
    "check:html-scripts": "node scripts/check-html-scripts.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3"
  }
}
